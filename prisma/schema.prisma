generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique 
  cedula    String   @unique
  password  String
  nombre    String?
  rol       String   @default("VENDEDOR") 
  estado    String   @default("Activo")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendedor             Vendedor?
  asignacionesVehiculo AsignacionVehiculo[]
  registrosCombustible RegistroCombustible[]
  rutasDiarias         RegistroRutaDiaria[]

  @@map("usuarios")
}

model Vendedor {
  id               Int         @id @default(autoincrement())
  cedula           String      @unique
  nombre           String
  apellido         String?
  puntosAcumulados Decimal     @default(0.00) @db.Decimal(10, 2)
  saldoGastado     Decimal     @default(0.00) @db.Decimal(10, 2)
  activo           Boolean     @default(true)
  usuarioId        Int?        @unique
  usuario          User?       @relation(fields: [usuarioId], references: [id])
  evidencias       Evidencia[]
  canjes           Canje[]     
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("vendedores")
}

model Campana {
  id          Int         @id @default(autoincrement())
  nombre      String
  descripcion String?     @db.Text
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean     @default(true)
  evidencias  Evidencia[]
  createdAt   DateTime    @default(now())
  urlImagen   String?
  valor       Float       @default(0)
  @@map("campanas") 
}

model Evidencia {
  id            Int      @id @default(autoincrement())
  urlImagen     String
  publicId      String
  clienteNombre String
  vendedorId    Int
  vendedor      Vendedor @relation(fields: [vendedorId], references: [id])
  campanaId     Int
  campana       Campana  @relation(fields: [campanaId], references: [id])
  valorPagado   Float    @default(2.00)
  estado        String   @default("pendiente")
  motivoRechazo String?  
  imageHash     String?  @unique 
  createdAt     DateTime @default(now())
}

model Premio {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  puntos      Float    
  urlImagen   String
  publicId    String
  stock       Int      @default(1)
  activo      Boolean  @default(true)
  reservado   Boolean  @default(false)
  canjes      Canje[]  
  createdAt   DateTime @default(now())
}

model Canje {
  id         Int      @id @default(autoincrement())
  vendedorId Int
  premioId   Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])
  premio     Premio   @relation(fields: [premioId], references: [id])
  estado     String   @default("pendiente") 
  createdAt  DateTime @default(now())
}

model ClienteWeb {
  id        Int      @id @default(autoincrement())
  cedula    String   @unique
  password  String  
  nombre    String   
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clientes_web")
}
model BodegaConfig {
  id                Int      @id @default(autoincrement())
  id_bodega_araujo  String   @unique
  es_principal      Boolean  @default(false)
  updated_at        DateTime @updatedAt
}
model ProductAdvertisement {
  id          Int      @id @default(autoincrement())
  productCode String   @unique @map("product_code")
  productName String   @map("product_name")        
  title       String                               
  imagePath   String   @map("image_path")          
  endDate     DateTime @map("end_date")            
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("product_advertisements")
}
model Vehiculo {
  id                  Int                   @id @default(autoincrement())
  placa               String                @unique
  marcaModelo         String                
  kmActual            Float                 @default(0)
  kmUltimoAceite      Float                 @default(0) 
  intervaloAlerta     Float                 @default(5000) 
  alertaMantenimiento Boolean               @default(false) 
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  registrosCombustible RegistroCombustible[]
  asignaciones         AsignacionVehiculo[]

  @@map("vehiculos")
}
model AsignacionVehiculo {
  id          Int       @id @default(autoincrement())
  userId      Int       
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehiculoId  Int
  vehiculo    Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  
  kmEntrega   Float     
  kmRecepcion Float?    
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime? 

  @@map("asignaciones_vehiculos")
}
model Gasolinera {
  id            Int                   @id @default(autoincrement())
  nombre        String                
  ciudad        String                
  tieneConvenio Boolean               @default(false)
  montoRecarga  Float                 @default(0)
  createdAt     DateTime              @default(now())
  
  registrosCombustible RegistroCombustible[]

  @@map("gasolineras")
}

model RegistroCombustible {
  id              Int        @id @default(autoincrement())
  userId          Int        
  user            User       @relation(fields: [userId], references: [id])
  vehiculoId      Int
  vehiculo        Vehiculo   @relation(fields: [vehiculoId], references: [id])
  gasolineraId    Int
  gasolinera      Gasolinera @relation(fields: [gasolineraId], references: [id])

  kmRecorridos    Float      
  precioTotal     Float      
  galones         Float      
  numFactura      String     @unique 
  fueraDeConvenio Boolean    @default(false)
  metodoPago      String     @default("CONVENIO")
  fechaFactura    DateTime   
  createdAt       DateTime   @default(now())

  @@map("registros_combustible")
}
model RegistroRutaDiaria {
  id           Int      @id @default(autoincrement())
  userId       Int      
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placaCarro   String   
  kmRecorridos Float    
  procesado    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("registros_rutas_diarias")
}